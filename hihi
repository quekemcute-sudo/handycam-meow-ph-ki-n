<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>handycam.meow - Quản Lý Máy Ảnh</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #fdf2f4; color: #4a3e3d; font-family: system-ui, -apple-system, sans-serif; }
    .card-pink { background: #ffffff; border-radius: 16px; box-shadow: 0 4px 15px rgba(235, 180, 190, 0.15); border: 1px solid #f9e2e7; }
    .btn-pink { background-color: #f472b6; color: white; font-weight: 600; border-radius: 12px; }
  </style>
</head>
<body class="p-4 max-w-md mx-auto min-h-screen pb-20">

  <div class="flex justify-between items-center mb-6 pt-2">
    <div>
      <h1 class="text-2xl font-bold text-pink-500 tracking-tight">handycam.meow</h1>
      <p class="text-xs text-pink-400 font-medium">Quản lý kho & bán hàng</p>
    </div>
    <button id="authBtn" onclick="toggleAuth()" class="px-3 py-1.5 text-xs font-semibold rounded-full border border-pink-300 text-pink-600 bg-white shadow-sm">
      👁️ Khách xem
    </button>
  </div>

  <div id="pinModal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-white p-6 rounded-2xl w-full max-w-xs text-center shadow-xl">
      <h3 class="font-bold text-gray-800 mb-2">Xác minh Nhân viên</h3>
      <input type="password" id="pinInput" maxlength="10" placeholder="••••" class="w-full text-center text-xl tracking-widest p-2 border border-pink-200 rounded-lg mb-4 focus:outline-none">
      <div class="flex gap-2">
        <button onclick="closePinModal()" class="flex-1 py-2 text-xs font-semibold text-gray-500 bg-gray-100 rounded-lg">Hủy</button>
        <button onclick="verifyPin()" class="flex-1 py-2 text-xs font-semibold text-white bg-pink-500 rounded-lg">Đăng nhập</button>
      </div>
    </div>
  </div>

  <div id="adminControls" class="hidden mb-4 space-y-2">
    <button onclick="document.getElementById('imgFileInput').click()" class="w-full btn-pink py-2.5 shadow-md flex items-center justify-center gap-2">
      <span>+ Thêm máy / Tải ảnh lên</span>
    </button>
    <input type="file" id="imgFileInput" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
  </div>

  <div id="productList" class="grid grid-cols-2 gap-3"></div>

  <script>
    const DEFAULT_PIN = "2007";
    let isStaff = false;
    let products = JSON.parse(localStorage.getItem('handycam_products')) || [];

    function saveAndRender() {
      try {
        localStorage.setItem('handycam_products', JSON.stringify(products));
      } catch (e) {
        alert("Bộ nhớ đầy, hãy xóa bớt sản phẩm cũ!");
      }
      renderProducts();
    }

    function renderProducts() {
      const container = document.getElementById('productList');
      container.innerHTML = '';

      products.forEach((p, idx) => {
        const isOutOfStock = p.stock <= 0;
        const card = document.createElement('div');
        card.className = 'card-pink overflow-hidden flex flex-col justify-between relative';
        
        card.innerHTML = `
          <div class="relative aspect-square bg-pink-50 flex items-center justify-center overflow-hidden">
            ${p.img 
              ? `<img src="${p.img}" class="w-full h-full object-cover">`
              : `<span class="text-xs font-bold text-pink-300">handycam.meow</span>`}
            
            <span class="absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded-full text-white ${isOutOfStock ? 'bg-red-400' : 'bg-emerald-400'}">
              ${isOutOfStock ? 'Hết hàng' : `Còn ${p.stock} cái`}
            </span>

            ${isStaff ? `
              <button onclick="deleteProduct(${idx})" class="absolute top-2 right-2 bg-white/80 p-1 rounded-full text-red-500 text-xs shadow">🗑️</button>
            ` : ''}
          </div>

          <div class="p-2.5">
            <div class="text-center font-bold text-pink-600 text-sm mb-1">
              ${Number(p.price).toLocaleString('vi-VN')}₫
            </div>

            <div class="flex items-center justify-between text-[11px] text-gray-500 pt-1 border-t border-pink-100">
              <span>Đã bán <b>${p.sold}</b></span>
              ${isStaff ? `
                <div class="flex items-center gap-1">
                  <button onclick="changeSold(${idx}, -1)" class="w-5 h-5 bg-pink-100 text-pink-600 font-bold rounded flex items-center justify-center">-</button>
                  <button onclick="changeSold(${idx}, 1)" class="w-5 h-5 bg-pink-500 text-white font-bold rounded flex items-center justify-center">+</button>
                </div>
              ` : `
                <span class="${isOutOfStock ? 'text-red-400' : 'text-emerald-500'} font-medium">
                  ${isOutOfStock ? 'Hết hàng' : 'Sẵn hàng'}
                </span>
              `}
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function toggleAuth() {
      if (isStaff) {
        isStaff = false;
        document.getElementById('authBtn').innerText = '👁️ Khách xem';
        document.getElementById('adminControls').classList.add('hidden');
        renderProducts();
      } else {
        document.getElementById('pinModal').classList.remove('hidden');
        document.getElementById('pinInput').focus();
      }
    }

    function verifyPin() {
      const pin = document.getElementById('pinInput').value;
      if (pin === DEFAULT_PIN) {
        isStaff = true;
        document.getElementById('authBtn').innerText = '🔑 Chế độ Nhân viên';
        document.getElementById('adminControls').classList.remove('hidden');
        closePinModal();
        renderProducts();
      } else {
        alert('Mật khẩu không đúng!');
      }
    }

    function closePinModal() {
      document.getElementById('pinInput').value = '';
      document.getElementById('pinModal').classList.add('hidden');
    }

    function handleImageUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const MAX_WIDTH = 500;
          const scale = MAX_WIDTH / img.width;
          canvas.width = MAX_WIDTH;
          canvas.height = img.height * scale;

          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.7);

          const price = prompt('Nhập giá máy (VNĐ):', '1500000');
          const stock = prompt('Nhập số lượng tồn kho:', '1');

          if (price) {
            products.unshift({
              id: Date.now(),
              price: parseInt(price) || 0,
              stock: parseInt(stock) || 1,
              sold: 0,
              img: compressedDataUrl
            });
            saveAndRender();
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function changeSold(idx, delta) {
      if (delta > 0 && products[idx].stock > 0) {
        products[idx].sold += 1;
        products[idx].stock -= 1;
      } else if (delta < 0 && products[idx].sold > 0) {
        products[idx].sold -= 1;
        products[idx].stock += 1;
      }
      saveAndRender();
    }

    function deleteProduct(idx) {
      if (confirm('Xóa máy này?')) {
        products.splice(idx, 1);
        saveAndRender();
      }
    }

    renderProducts();
  </script>
</body>
</html>
